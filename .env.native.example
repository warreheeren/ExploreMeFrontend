# Native app (Capacitor): kopieer naar .env.native en vul in. `npm run build:native` gebruikt --mode native.
# De app draait op https://localhost (Android) / capacitor://localhost (iOS) zonder proxy: de API-URL moet absoluut zijn.
# VITE_NATIVE_API_URL gaat in de app vóór VITE_API_URL (die in .env.local vaak naar localhost wijst).
VITE_NATIVE_API_URL=https://api.example.com
# Gehoste webapp: links die je vanuit de app deelt (posts, reizen, QR-codes) wijzen hiernaar.
VITE_PUBLIC_WEB_URL=https://app.example.com
